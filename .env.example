# Modelo de configuração local — copie para .env e ajuste antes de expor o serviço.
# O Docker Compose lê este arquivo automaticamente; fora dele, exporte as variáveis.

# Credenciais para escrita e exportação em rede compartilhada.
# Deixe em branco somente em ambiente local de loopback (padrão do projeto).
RADAR_ADMIN_PASSWORD=
RADAR_API_KEY=

# Metadados da imagem. Vazios → scripts/gerar_versao.sh usa o histórico Git.
APP_VERSION=
APP_COMMIT=
APP_COUNT=

# CSV bruto usado pelos scripts do auxílio emergencial.
AUXILIO_CSV_PATH=./data/auxilio_emergencial.csv
